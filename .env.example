# ── .env (se sube a git; valores públicos) ──────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Dominio donde está desplegada la web (solo para el APK)
# EXPO_PUBLIC_API_URL=https://tudominio.com
# Uso personal: "false" oculta el registro en la app
# EXPO_PUBLIC_SIGNUP_OPEN=false

# ── .env.local (NO se sube a git; secretos del servidor) ────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
# Uso personal: usuarios que pueden usar la IA, separados por coma (vacío = todos)
# AI_ALLOWED_USERS=irvin
# Opcional: EXPO_PUBLIC_QUOTES_API_URL, GROQ_MODEL (por defecto openai/gpt-oss-120b)
