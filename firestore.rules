rules_version = '2';

// Cada jugador solo puede leer y escribir sus propios datos, y solo con el formato que usa la app.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function hasOnlyFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isStat(value) {
      return value in ['STR', 'INT', 'VIT', 'AGI', 'PER'];
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);

      function isValidProfile(data) {
        return hasOnlyFields(data, ['name', 'username', 'email', 'photo', 'calendarUrl', 'totalXp', 'stats', 'createdAt'])
          && isText(data.name, 40) && data.name.size() > 0
          && data.totalXp is int
          && data.totalXp >= 0
          && data.stats is map
          && data.stats.keys().hasOnly(['STR', 'INT', 'VIT', 'AGI', 'PER'])
          && data.stats.keys().hasAll(['STR', 'INT', 'VIT', 'AGI', 'PER'])
          && data.stats.STR is int && data.stats.STR >= 0
          && data.stats.INT is int && data.stats.INT >= 0
          && data.stats.VIT is int && data.stats.VIT >= 0
          && data.stats.AGI is int && data.stats.AGI >= 0
          && data.stats.PER is int && data.stats.PER >= 0
          // La foto es un data URI JPEG de 256 px (~20-40 KB); 300 KB deja margen sin permitir abusos.
          && (!('photo' in data) || data.photo == null || isText(data.photo, 300000))
          && (!('calendarUrl' in data) || data.calendarUrl == null || isText(data.calendarUrl, 1000));
      }

      match /missions/{missionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['title', 'time', 'icon', 'xp', 'stat', 'createdAt'])
          && isText(request.resource.data.title, 60) && request.resource.data.title.size() > 0
          && isTime(request.resource.data.time)
          && request.resource.data.xp in [10, 20, 35, 50]
          && isStat(request.resource.data.stat)
          && isText(request.resource.data.icon, 8);
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['title', 'date', 'start', 'end', 'location', 'category', 'source', 'createdAt', 'syncedAt'])
          && isText(request.resource.data.title, 60) && request.resource.data.title.size() > 0
          && isDateKey(request.resource.data.date)
          && isTime(request.resource.data.start)
          && isTime(request.resource.data.end)
          && request.resource.data.end > request.resource.data.start
          && isText(request.resource.data.location, 60)
          && isText(request.resource.data.category, 20)
          // Eventos importados del calendario externo (Notion Calendar / Google).
          && (!('source' in request.resource.data) || request.resource.data.source == 'calendar');
      }

      match /dailyProgress/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['dateKey', 'completedMissionIds', 'rewards', 'totalMissions', 'updatedAt'])
          && isDateKey(dateKey)
          && request.resource.data.completedMissionIds is list
          && request.resource.data.completedMissionIds.size() <= 100
          && request.resource.data.totalMissions is int
          && request.resource.data.totalMissions >= 0;
      }

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['title', 'description', 'status', 'priority', 'dueDate', 'estimateMinutes', 'projectId'])
          && isText(request.resource.data.title, 120) && request.resource.data.title.size() > 0
          && isText(request.resource.data.description, 1200)
          && request.resource.data.status in ['pending', 'in_progress', 'blocked', 'completed']
          && request.resource.data.priority in ['low', 'normal', 'high']
          && (request.resource.data.dueDate == null || isDateKey(request.resource.data.dueDate))
          && (request.resource.data.estimateMinutes == null || (request.resource.data.estimateMinutes is int && request.resource.data.estimateMinutes >= 1 && request.resource.data.estimateMinutes <= 1440))
          && (request.resource.data.projectId == null || isText(request.resource.data.projectId, 128));
      }

      match /projects/{projectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['title', 'purpose', 'status', 'nextAction', 'deadline'])
          && isText(request.resource.data.title, 120) && request.resource.data.title.size() > 0
          && isText(request.resource.data.purpose, 1200)
          && request.resource.data.status in ['active', 'paused', 'blocked', 'completed']
          && isText(request.resource.data.nextAction, 300)
          && (request.resource.data.deadline == null || isDateKey(request.resource.data.deadline));
      }

      match /goals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['title', 'measure', 'nextStep', 'horizon', 'targetDate', 'status'])
          && isText(request.resource.data.title, 120) && request.resource.data.title.size() > 0
          && isText(request.resource.data.measure, 300)
          && isText(request.resource.data.nextStep, 300)
          && request.resource.data.horizon in ['short', 'medium', 'long']
          && request.resource.data.status in ['active', 'paused', 'completed']
          && (request.resource.data.targetDate == null || isDateKey(request.resource.data.targetDate));
      }

      match /notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyFields(request.resource.data, ['title', 'body'])
          && isText(request.resource.data.title, 120) && request.resource.data.title.size() > 0
          && isText(request.resource.data.body, 12000);
      }

      match /discovery/{documentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && documentId == 'profile'
          && hasOnlyFields(request.resource.data, [
            'lifeAreas', 'fixedCommitments', 'currentRoutine', 'nearTermGoal', 'futureGoal',
            'focusWindow', 'frictionPoints', 'supportStyle', 'carePriorities',
            'completed', 'aiPersonalizationConsent', 'updatedAt'
          ])
          && request.resource.data.lifeAreas is list
          && request.resource.data.lifeAreas.size() <= 7
          && request.resource.data.lifeAreas.hasOnly(['work', 'study', 'home', 'care', 'health', 'projects', 'other'])
          && isText(request.resource.data.fixedCommitments, 600)
          && isText(request.resource.data.currentRoutine, 600)
          && isText(request.resource.data.nearTermGoal, 500)
          && isText(request.resource.data.futureGoal, 500)
          && request.resource.data.focusWindow in ['morning', 'midday', 'afternoon', 'evening', 'varies']
          && request.resource.data.frictionPoints is list
          && request.resource.data.frictionPoints.size() <= 6
          && request.resource.data.frictionPoints.hasOnly(['too-much', 'unclear-start', 'interruptions', 'low-energy', 'consistency', 'time'])
          && request.resource.data.supportStyle in ['gentle', 'direct', 'structured']
          && request.resource.data.carePriorities is list
          && request.resource.data.carePriorities.size() <= 5
          && request.resource.data.carePriorities.hasOnly(['rest', 'meals', 'relationships', 'free-time', 'movement'])
          && request.resource.data.completed is bool
          && request.resource.data.aiPersonalizationConsent is bool
          && request.resource.data.updatedAt is timestamp;
      }
    }
  }
}
