{
  "expo": {
    "name": "SYSTEM",
    "slug": "system-habitos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "systemhabitos",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.irvin.systemhabitos",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.irvin.systemhabitos",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SYSTEM necesita acceso a tus fotos para cambiar tu foto de perfil.",
          "cameraPermission": "SYSTEM necesita la cámara para tomar tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "SYSTEM usa Face ID para que entres a tu cuenta sin escribir la contraseña."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SYSTEM usa Face ID para que entres a tu cuenta sin escribir la contraseña."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ba9bcff-a486-4e72-b229-39904d43b183"
      }
    },
    "owner": "irvinchavs"
  }
}
